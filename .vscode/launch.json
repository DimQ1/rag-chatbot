{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend: Chrome (localhost:4200)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/rag-chatbot"
    },
    {
      "name": "Frontend: ng serve + Chrome",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "frontend: ng serve",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/rag-chatbot",
      "sourceMapPathOverrides": {
        "webpack:/*": "${workspaceFolder}/rag-chatbot/*",
        "/./*": "${workspaceFolder}/rag-chatbot/*"
      }
    },
    {
      "name": "Backend: .NET API (debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "backend: build",
      "program": "${workspaceFolder}/rag-chatbot-api/bin/Debug/net10.0/rag-chatbot-api.dll",
      "cwd": "${workspaceFolder}/rag-chatbot-api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5024"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Frontend + Backend",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "start: fullstack",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/rag-chatbot"
    }
  ]
}
